---
import SiteLayout from '../layouts/SiteLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { products } from '../data/products';
const featuredProducts = products.slice(0, 4);
---
<SiteLayout title="Discover your next favourite" description="Explore the InfiniCharm marketplace prototype: thoughtfully selected demo products, categories, and seller discovery.">
  <section class="hero-section">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow hero-kicker"><span class="tiny-line"></span> A NEW WAY TO DISCOVER</p>
        <h1>Find something<br />that feels <span class="coral-text">like you.</span></h1>
        <p class="hero-description">A fresh marketplace for considered finds, independent sellers, and everyday discoveries. This is the first working preview of InfiniCharm.</p>
        <div class="hero-actions"><a class="button button-primary" href="/shop/">Explore the collection <span aria-hidden="true">↗</span></a><a class="text-link" href="/seller/">Selling on InfiniCharm <span aria-hidden="true">→</span></a></div>
        <div class="hero-footnote"><span class="hero-index mono">IC / 001</span><span>Built by Techily Fly</span><span class="hero-footline"></span></div>
      </div>
      <div class="hero-art" aria-label="Illustrative product arrangement for the InfiniCharm demo">
        <div class="hero-art-top"><span class="mono">THE EVERYDAY EDIT</span><span class="art-star" aria-hidden="true">✳</span></div>
        <div class="hero-art-main">
          <div class="art-orbit orbit-one"></div><div class="art-orbit orbit-two"></div>
          <div class="art-center-card"><span class="art-symbol" aria-hidden="true">i✳</span><span class="mono art-card-label">INFINICHARM / OBJECTS</span></div>
          <div class="art-floating art-floating-one"><span class="art-mini-icon">◌</span><span><small>CURATED</small><strong>New finds</strong></span></div>
          <div class="art-floating art-floating-two"><span class="art-mini-icon coral-fill">✳</span><span><small>MADE TO DISCOVER</small><strong>Your next favourite</strong></span></div>
        </div>
        <div class="hero-art-bottom"><span>Thoughtful by design.</span><span class="mono">01 — 06 / DEMO ITEMS</span></div>
      </div>
    </div>
  </section>

  <section class="trust-strip"><div class="container trust-strip-inner"><span>One destination</span><span class="trust-cross">✳</span><span>Many sellers</span><span class="trust-cross">✳</span><span>More to discover</span><span class="mono trust-aside">THE MARKETPLACE STARTS HERE</span></div></section>

  <section class="section container" id="featured">
    <div class="section-heading"><div><p class="eyebrow">THE FIRST EDIT <span class="mono">/ 01</span></p><h2>Good things, <span class="muted-heading">just ahead.</span></h2><p class="section-description">Explore sample listings while we build the real seller, inventory, and order systems.</p></div><a class="text-link section-heading-link" href="/shop/">View all demo products <span aria-hidden="true">↗</span></a></div>
    <div class="product-grid">{featuredProducts.map((product) => <ProductCard product={product} />)}</div>
    <p class="demo-disclaimer"><span class="mono">NOTE</span> All products, prices, and availability on this starter site are fictional demo data.</p>
  </section>

  <section class="seller-banner">
    <div class="container seller-banner-inner"><div><p class="eyebrow">BUILT FOR MORE THAN BUYING</p><h2>Have something<br />worth <span class="coral-text">sharing?</span></h2><p>Our seller experience begins with clear product tools and grows into a complete marketplace workflow.</p></div><a class="button button-light" href="/seller/">Explore seller preview <span aria-hidden="true">↗</span></a><div class="banner-orbit" aria-hidden="true">✳</div></div>
  </section>
</SiteLayout>
