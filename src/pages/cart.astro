---
import SiteLayout from '../layouts/SiteLayout.astro';
import { products } from '../data/products';
import { productImageUrl } from '../lib/cloudinary';
const cartProducts = products.map((product) => ({ slug: product.slug, name: product.name, price: product.price, image: productImageUrl(product.imagePublicId, 240) }));
---
<SiteLayout title="Your demo bag" description="Review your InfiniCharm demo cart. No checkout or payment is active.">
  <section class="page-hero container cart-page-hero"><p class="eyebrow">YOUR SPACE / BAG</p><h1>The things you<br /><span class="coral-text">found.</span></h1><p class="page-intro">This cart is stored only in this browser for demonstration. It does not create an order or process a payment.</p></section>
  <section class="container cart-section" data-cart-root data-products={JSON.stringify(cartProducts)}>
    <div class="cart-layout"><div class="cart-main"><div class="cart-list-heading"><h2>Your bag <span class="cart-sub-count" data-cart-items-count>(0 items)</span></h2><button class="text-button" type="button" data-clear-cart>Clear bag</button></div><div class="cart-items" data-cart-items aria-live="polite"></div><div class="cart-empty" data-cart-empty><div class="empty-icon">✳</div><h3>Your bag is waiting.</h3><p>Find a little something to start your demo bag.</p><a class="button button-outline" href="/shop/">Explore the collection <span aria-hidden="true">↗</span></a></div></div>
      <aside class="cart-summary"><p class="eyebrow">ORDER SUMMARY / DEMO</p><div class="summary-row"><span>Subtotal</span><strong data-cart-subtotal>₹0</strong></div><div class="summary-row"><span>Shipping</span><span class="summary-muted">Not calculated</span></div><div class="summary-row"><span>Taxes</span><span class="summary-muted">Not calculated</span></div><div class="summary-total"><span>Estimated total</span><strong data-cart-total>₹0</strong></div><button class="button button-primary checkout-button" type="button" disabled aria-disabled="true">Checkout — coming in Phase 2 <span aria-hidden="true">→</span></button><p class="summary-disclaimer">No order is submitted. No payment information is collected or stored.</p><a class="text-link" href="/shop/">Continue exploring <span aria-hidden="true">↗</span></a></aside></div>
  </section>
  <script>
    const root = document.querySelector('[data-cart-root]');
    if (root) root.setAttribute('data-products', root.getAttribute('data-products') || '[]');
  </script>
</SiteLayout>
