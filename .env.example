# Supabase Public Configuration (Safe for Client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Supabase Server-Only Secret (Never expose to client bundle!)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Tawk.to Live Care Widget Configuration
NEXT_PUBLIC_TAWKTO_PROPERTY_ID=your_tawkto_property_id
NEXT_PUBLIC_TAWKTO_WIDGET_ID=your_tawkto_widget_id

# Canonical Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Payment Gateway Secrets (Server-Side Only)
PAYMENT_GATEWAY_KEY_ID=your_payment_key_id
PAYMENT_GATEWAY_KEY_SECRET=your_payment_key_secret
PAYMENT_GATEWAY_WEBHOOK_SECRET=your_payment_webhook_secret

# Brevo Email Delivery & SMTP Relay Configuration (Server-Side Only)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_smtp_login
BREVO_SMTP_PASSWORD=your_brevo_smtp_key_if_using_direct_smtp
BREVO_DEFAULT_SENDER_EMAIL=support@infinicharm.com
BREVO_DEFAULT_SENDER_NAME=InfiniCharm
SMTP_ENCRYPTION_SECRET=your_32_byte_encryption_secret_here


